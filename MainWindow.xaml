<Window x:Class="Task_Manager_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Manager_GUI"
        mc:Ignorable="d"
        xmlns:view="clr-namespace:Task_Manager_GUI.src.Views"
        xmlns:vms="clr-namespace:Task_Manager_GUI.src.Viewmodels"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type vms:AddTaskViewModel}">
                <view:AddTaskView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:ListingTasksViewModel}">
                <view:ListingTasksView />
            </DataTemplate>
        </Grid.Resources>

        <ContentControl Content="{Binding CurrentViewModel}" />

        <!--<view:AddTaskView />-->
    </Grid>
</Window>
