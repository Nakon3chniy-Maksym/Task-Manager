<UserControl x:Class="Task_Manager_GUI.src.Views.AddTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Task_Manager_GUITask_Manager_GUI.src.ViewServices"
             xmlns:enums="clr-namespace:Task_Manager_GUI.src.Enums"
             mc:Ignorable="d"
             Background="#31313d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Add New Task"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0 35 0 0"
                   Grid.Row="0" />

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <ControlTemplate x:Key="RoundButtonTemplate"
                                 TargetType="Button">
                    <Border CornerRadius="20"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>

                <ControlTemplate x:Key="TextBoxWithPlaceholder"
                                 TargetType="TextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}" />

                        <TextBlock x:Name="PlaceholderText"
                                   Text="{Binding Path=(local:PlaceholderService.PlaceholderText),
                                                  RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                   FontSize="{Binding Path=(local:PlaceholderService.PlaceholderFontSize),
                                                      RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"
                                   FontStyle="Italic" />

                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused"
                                           Value="False" />
                                <Condition Property="Text"
                                           Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText"
                                    Property="Visibility"
                                    Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

                <enums:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            </Grid.Resources>

            <TextBox Grid.Row="0"
                     Background="#3d3d4a"
                     Foreground="White"
                     Height="35"
                     Width="500"
                     Margin="0 50 0 0"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     FontSize="22"
                     BorderBrush="Transparent"
                     local:PlaceholderService.PlaceholderText="Title"
                     local:PlaceholderService.PlaceholderFontSize="17   "
                     Template="{StaticResource TextBoxWithPlaceholder}"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox Grid.Row="1"
                     Background="#3d3d4a"
                     Foreground="White"
                     Height="50"
                     Width="500"
                     Margin="0 20 0 0"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     FontSize="24"
                     BorderBrush="Transparent"
                     local:PlaceholderService.PlaceholderText="Description"
                     local:PlaceholderService.PlaceholderFontSize="22"
                     Template="{StaticResource TextBoxWithPlaceholder}"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0 40 0 0"
                        Orientation="Horizontal">

                <RadioButton GroupName="Priority"
                             Content="Low"
                             Foreground="White"
                             FontSize="20"
                             VerticalContentAlignment="Center"
                             IsChecked="{Binding Urgency,
                                        Converter={StaticResource EnumToBooleanConverter},
                                        ConverterParameter={x:Static enums:DegOfUrgency.Low},
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}" />    
                <RadioButton GroupName="Priority"
                             Content="Medium"
                             Foreground="White"
                             FontSize="20"
                             Margin="20 0 0 0"
                             VerticalContentAlignment="Center"
                             IsChecked="{Binding Urgency,
                                        Converter={StaticResource EnumToBooleanConverter},
                                        ConverterParameter={x:Static enums:DegOfUrgency.Medium},
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>
                <RadioButton GroupName="Priority"
                             Content="High"
                             Foreground="White"
                             FontSize="20"
                             Margin="20 0 0 0"
                             VerticalContentAlignment="Center"
                             IsChecked="{Binding Urgency,
                                        Converter={StaticResource EnumToBooleanConverter},
                                        ConverterParameter={x:Static enums:DegOfUrgency.High},
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="SubmitButton"
                        Content="Submit"
                        Background="#046276"
                        Foreground="White"
                        FontSize="20"
                        Width="100"
                        Height="40"
                        BorderBrush="Transparent"
                        Margin="0 0 50 0"
                        Template="{StaticResource RoundButtonTemplate}"
                        Command="{Binding SubmitCommand}" />

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Background="#046276"
                        Foreground="White"
                        FontSize="20"
                        Width="100"
                        Height="40"
                        BorderBrush="Transparent"
                        Template="{StaticResource RoundButtonTemplate}"
                        Command="{Binding CancelCommand}" />

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
